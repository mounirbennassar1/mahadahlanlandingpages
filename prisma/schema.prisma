generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  AGENT
}

enum LeadStatus {
  INQUIRY
  CONFIRMED
  BOOKED
  CANCELLED
  NO_ANSWER
  NOT_INTERESTED
}

enum UtmPlatform {
  GOOGLE_ADS
  INSTAGRAM
  TIKTOK
  X
  SNAPCHAT
}

enum ConversionType {
  WHATSAPP
  FORM
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum PaymentMethod {
  COD
  TAMARA
  TABBY
  CARD
}

enum LeadActivityType {
  CREATED
  NOTE
  STATUS
  ASSIGN
  PAYMENT
}

/// Lifecycle of an online payment started from a page (see docs/payments.md).
enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum OrderItemType {
  PACKAGE
  OFFER
}

enum OrderEventType {
  CREATED
  CHECKOUT
  RETURN
  WEBHOOK
  SYNC
  STATUS
  REFUND
  NOTE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(AGENT)
  avatarHue    Int      @default(295)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedLeads  Lead[]         @relation("AssignedLeads")
  pageEdits      PageContent[]
  leadActivities LeadActivity[]
  orderEvents    OrderEvent[]
}

model LeadSource {
  id         String   @id @default(cuid())
  slug       String   @unique
  label      String
  apiKeyHash String   @unique
  apiKeyHint String
  origin     String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  leads       Lead[]
  utmLinks    UtmLink[]
  conversions ConversionAction[]
}

model ConversionAction {
  id              String         @id @default(cuid())
  sourceId        String
  source          LeadSource     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  type            ConversionType
  conversionId    String?
  conversionLabel String?
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([sourceId, type])
  @@index([sourceId])
}

model UtmLink {
  id          String      @id @default(cuid())
  sourceId    String
  source      LeadSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  platform    UtmPlatform
  utmSource   String
  utmMedium   String
  utmCampaign String
  url         String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([sourceId, platform])
  @@index([sourceId])
}

model Lead {
  id         String     @id @default(cuid())
  fullName   String
  phone      String
  city       String
  status     LeadStatus @default(INQUIRY)
  notesCount Int        @default(0)

  sourceId String
  source   LeadSource @relation(fields: [sourceId], references: [id])

  assigneeId String?
  assignee   User?   @relation("AssignedLeads", fields: [assigneeId], references: [id])

  // UTM attribution — captured from URL params at form submission.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?

  // Website booking extras (book-now page, offers modal). All optional so the
  // landing-page forms keep posting { fullName, phone, city } unchanged.
  email         String?
  service       String?
  message       String?
  preferredAt   DateTime?
  paymentMethod PaymentMethod?
  offerId       String?
  offer         Offer?         @relation(fields: [offerId], references: [id], onDelete: SetNull)

  // Extra per-page form answers, e.g. { "time": "مساءً" }. Written by
  // /api/leads from the optional `extra` body field; rendered in the panel.
  data Json?

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  activities LeadActivity[]
  orders     Order[]

  @@index([sourceId, submittedAt])
  @@index([status])
  @@index([assigneeId])
  @@index([city])
  @@index([utmSource])
  @@index([utmCampaign])
  @@index([offerId])
}

// ───────────────────────── Website content (managed in /dashboard) ─────────────────────────

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  articles Article[]
}

model Article {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  excerpt        String?
  /// HTML produced by the dashboard rich-text editor.
  content        String
  coverImage     String?
  coverAlt       String?
  status         ContentStatus @default(DRAFT)
  featured       Boolean       @default(false)
  publishedAt    DateTime?
  readingMinutes Int?
  seoTitle       String?
  seoDescription String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  authorId   String?
  author     Doctor?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([authorId])
}

model Doctor {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  /// Role line, e.g. "استشارية الجلدية والتجميل والليزر".
  title       String
  bio         String?
  credentials String[] @default([])
  specialties String[] @default([])
  image       String?
  imageAlt    String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  articles Article[]
}

model Device {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  nameEn      String?
  tagline     String?
  description String?
  usedFor     String[] @default([])
  image       String?
  imageAlt    String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Offer {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  description String?
  /// Whole Saudi riyals.
  price       Int
  oldPrice    Int?
  badge       String?
  category    String?
  image       String?
  imageAlt    String?
  order       Int       @default(0)
  active      Boolean   @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  leads  Lead[]
  orders Order[]
}

model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  /// Grouping shown in the booking select, e.g. "خدمات البشرة".
  group       String?
  description String?
  /// Slug of a landing under app/(landings)/ this service links to, if any.
  landingSlug String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// One row per lead event: creation, a staff note, a status change or a
/// reassignment. Powers the timeline on /dashboard/leads/[id].
model LeadActivity {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  type LeadActivityType
  body String?
  meta Json?

  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

/// Editable copy for a public page, keyed by the registry slug in
/// `lib/pages/registry.ts`. `data` holds ONLY the fields an admin changed,
/// as a flat map of "section.field" -> string | string[] | object[]; every
/// other field falls back to the default declared in the page's content.ts.
model PageContent {
  slug String @id
  data Json   @default("{}")

  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

// ───────────────────────── Online payments (noon) ─────────────────────────

/// A priced treatment sold from a landing page through noon payments.
/// `pageSlug` is the registry slug of the landing it belongs to; null means the
/// package is offered on every page that has a "pay" button.
model Package {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  description String?
  /// Whole Saudi riyals.
  price       Int
  oldPrice    Int?
  badge       String?
  /// Short bullet points shown on the package card.
  features    String[]  @default([])
  pageSlug    String?
  image       String?
  imageAlt    String?
  order       Int       @default(0)
  active      Boolean   @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  orders Order[]

  @@index([pageSlug, active])
}

/// One checkout attempt. Created before the customer is sent to noon's hosted
/// page; the status follows noon's order status through the return page,
/// webhooks and manual syncs from the dashboard.
model Order {
  id        String      @id @default(cuid())
  /// Merchant reference sent to noon, e.g. "MD-K2N9V3-7Q4A".
  reference String      @unique
  status    OrderStatus @default(PENDING)
  /// Whole Saudi riyals.
  amount    Int
  currency  String      @default("SAR")

  itemType  OrderItemType
  /// Snapshot of what was bought, so the row survives package/offer edits.
  itemTitle String
  packageId String?
  package   Package?      @relation(fields: [packageId], references: [id], onDelete: SetNull)
  offerId   String?
  offer     Offer?        @relation(fields: [offerId], references: [id], onDelete: SetNull)

  fullName String
  phone    String
  city     String
  email    String?

  /// Registry slug of the page the checkout started on (see lib/pages/registry.ts).
  pageSlug String?
  /// The CRM lead opened for this customer at checkout time.
  leadId   String?
  lead     Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?

  /// noon's own order id, once INITIATE succeeded.
  noonOrderId   String?   @unique
  /// Raw last status reported by noon (CAPTURED, FAILED, ...).
  noonStatus    String?
  /// Card scheme / wallet reported by noon (MADA, VISA, APPLE_PAY, ...).
  paymentBrand  String?
  checkoutUrl   String?
  paidAt        DateTime?
  refundedAmount Int      @default(0)
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events OrderEvent[]

  @@index([status, createdAt])
  @@index([pageSlug, createdAt])
  @@index([leadId])
  @@index([phone])
  @@index([createdAt])
}

/// Audit trail of an order: creation, redirect to noon, return, webhooks,
/// manual syncs, refunds and staff notes.
model OrderEvent {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  type OrderEventType
  body String?
  meta Json?

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}
