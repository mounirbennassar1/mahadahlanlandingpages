# Neon Postgres, the SAME database as the website repo. DATABASE_URL is the
# pooled URL (-pooler...); DIRECT_DATABASE_URL is only read by the Prisma CLI.
# The schema is owned by the website repo: never run `prisma db push` here.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# The website. Canonical / Open Graph URLs point there (so Google indexes the
# website, not this host), noon returns visitors there after paying, and every
# non-landing path on this host is redirected there.
NEXT_PUBLIC_SITE_URL="https://www.mahadahlan.com"

# Optional — restricts /api/leads CORS to listed origins (comma-separated).
# Leave empty to allow any origin.
LANDING_ORIGINS="https://lp.mahadahlan.com"

# Keeps this host out of Google's index, so only the website competes in
# search. Leave "false" until the website is indexed in Search Console,
# otherwise you deindex the pages that rank today. Crawling stays allowed.
NOINDEX_ADS_HOST="false"

# Optional — used by the gpt-image-2 skill (local dev only).
# OPENAI_API_KEY="sk-proj-..."

# ── noon payments (online checkout) ──────────────────────────────────────────
# Same values as the website repo. From the noon dashboard: Business
# identifier, Application identifier and Application key. The landings refuse
# to open a checkout (and point visitors to WhatsApp) until all three are set.
NOON_BUSINESS_ID=""
NOON_APP_ID=""
NOON_APP_KEY=""
NOON_ENV="test"
# "sa" (Saudi Arabia, default), "eg" (Egypt) or "global" (UAE and others).
NOON_REGION="sa"
# Optional. Order category configured in noon (defaults to "pay").
NOON_ORDER_CATEGORY="pay"
# Optional. Secret configured on the webhook in the noon dashboard. Point the
# webhook at the website (https://www.mahadahlan.com/api/noon/webhook); this
# host has the same handler but one URL is enough since the database is shared.
NOON_WEBHOOK_SECRET=""
