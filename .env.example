# Neon Postgres. DATABASE_URL is the pooled URL (-pooler...); DIRECT is the
# direct one used by Prisma migrations and the shadow DB.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# NextAuth (panel login). Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET="<32-byte base64>"
AUTH_URL="https://portal.mahadahlan.com"

# Created on first `npm run db:seed`.
ADMIN_EMAIL="admin@mahadahlan.com"
ADMIN_PASSWORD="change-me-please"
ADMIN_NAME="Mahadahlan Admin"

# Optional — restricts /api/leads CORS to listed origins (comma-separated).
# Leave empty to allow any origin.
LANDING_ORIGINS="https://mahadahlan.com,https://www.mahadahlan.com"

# Optional — used in canonical/OG metadata on the landings.
NEXT_PUBLIC_SITE_URL="https://www.mahadahlan.com"

# Optional — used by the gpt-image-2 skill (local dev only).
# OPENAI_API_KEY="sk-proj-..."

# Optional — Vercel Blob token for image uploads from the dashboard CMS
# (/dashboard/content/*). Without it, uploads fall back to public/uploads/ in
# local dev and fail in production (paste an image URL instead).
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Keeps lp.mahadahlan.com (the host the ads point at) out of Google's index, so
# only mahadahlan.com competes in search. Leave unset until the main domain is
# indexed in Search Console, otherwise you deindex the pages that rank today.
NOINDEX_ADS_HOST="false"

# ── noon payments (online checkout) ──────────────────────────────────────────
# From the noon dashboard: Business identifier, Application identifier and
# Application key. The site refuses to open a checkout (and points visitors to
# WhatsApp) until all three are set. Use "test" with the sandbox credentials and
# switch to "live" only with the production ones.
NOON_BUSINESS_ID=""
NOON_APP_ID=""
NOON_APP_KEY=""
NOON_ENV="test"
# noon runs one platform per region and the account only exists on its own:
# "sa" (Saudi Arabia, default), "eg" (Egypt) or "global" (UAE and others).
NOON_REGION="sa"
# Optional. Order category configured in noon (defaults to "pay").
NOON_ORDER_CATEGORY="pay"
# Optional. Secret configured on the webhook in the noon dashboard; when set,
# webhook signatures are verified. The webhook URL is /api/noon/webhook.
NOON_WEBHOOK_SECRET=""
# Optional. Merchant public key from the noon portal (PEM on one line, with \n
# between lines). Only needed if card data is ever encrypted on our side; the
# hosted checkout does not use it. Test and live portals have different keys.
NOON_PUBLIC_KEY=""
